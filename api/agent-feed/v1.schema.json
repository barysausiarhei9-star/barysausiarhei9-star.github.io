{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schrodingercat.org/api/agent-feed/v1.schema.json",
  "title": "Agent Feed v1.0.0",
  "description": "Static inventory of canonical public HTML pages and their explicitly linked resources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "entries"],
  "properties": {
    "$schema": { "const": "https://schrodingercat.org/api/agent-feed/v1.schema.json" },
    "version": { "const": "1.0.0" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_url", "language", "content_type", "title", "page_type", "text_availability"],
      "properties": {
        "id": { "$ref": "#/$defs/pageUrl" },
        "canonical_url": { "$ref": "#/$defs/pageUrl" },
        "language": { "enum": ["ru", "en"] },
        "content_type": { "const": "text/html" },
        "title": { "type": "string", "minLength": 1 },
        "page_type": { "enum": ["content", "section_index", "placeholder"] },
        "text_availability": { "enum": ["html_text", "image_only", "heading_only"] },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "page_type": { "const": "placeholder" } } },
          "then": { "properties": { "text_availability": { "const": "heading_only" } } },
          "else": { "properties": { "text_availability": { "enum": ["html_text", "image_only"] } } }
        },
        {
          "if": { "properties": { "text_availability": { "const": "image_only" } } },
          "then": {
            "required": ["resources"],
            "properties": { "page_type": { "const": "content" } }
          }
        }
      ]
    },
    "pageUrl": {
      "type": "string",
      "pattern": "^https://schrodingercat\\.org/(?:[a-z0-9-]+/)*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "language", "content_type", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/resourceUrl" },
        "url": { "$ref": "#/$defs/resourceUrl" },
        "language": { "enum": ["ru", "en"] },
        "content_type": { "enum": ["application/pdf", "image/png", "application/epub+zip"] },
        "title": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "properties": {
          "content_type": { "const": "application/pdf" },
          "id": { "pattern": "\\.pdf$" }, "url": { "pattern": "\\.pdf$" }
        } },
        { "properties": {
          "content_type": { "const": "image/png" },
          "id": { "pattern": "\\.png$" }, "url": { "pattern": "\\.png$" }
        } },
        { "properties": {
          "content_type": { "const": "application/epub+zip" },
          "id": { "pattern": "\\.epub$" }, "url": { "pattern": "\\.epub$" }
        } }
      ]
    },
    "resourceUrl": {
      "type": "string",
      "pattern": "^https://schrodingercat\\.org/assets/[a-z0-9/-]+\\.(?:pdf|png|epub)$"
    }
  }
}
